# Postgres connection (home server: Postgres 16 on 127.0.0.1:5432)
DATABASE_URL=postgres://lms_portal:CHANGE_ME@127.0.0.1:5432/lms_portal

# Uploaded files: Cloudflare R2 in production (set all four), local folder otherwise.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Total upload cap across all agencies, in bytes (default 8 GB, inside R2's free 10 GB)
# STORAGE_LIMIT_BYTES=
# Used only when R2_BUCKET is empty (local development)
FILE_STORAGE_DIR=./uploads

# Public URL of the portal, used to build invite links
APP_URL=http://localhost:3000

# Set to "false" only when testing over plain http on the LAN
COOKIE_SECURE=true
