# Postgres connection (home server: Postgres 16 on 127.0.0.1:5432)
DATABASE_URL=postgres://lms_portal:CHANGE_ME@127.0.0.1:5432/lms_portal

# Uploaded files: Cloudflare R2 in production (set all four), local folder otherwise.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Total upload cap across all agencies, in bytes (default 8 GB, inside R2's free 10 GB)
# STORAGE_LIMIT_BYTES=
# Used only when R2_BUCKET is empty (local development)
FILE_STORAGE_DIR=./uploads

# Public URL of the portal, used to build invite links
APP_URL=http://localhost:3000

# Set to "false" only when testing over plain http on the LAN
COOKIE_SECURE=true

# Signs the tokens for the Request website changes frame (/site/<token>/...). Any long random
# string. Without it each process makes its own and open frames need a reload after a restart.
REVIEW_SECRET=
# Local testing only: lets the frame load a site on localhost or the LAN. Never in production.
# REVIEW_ALLOW_PRIVATE=true

# Online payments on Billing (docs/online-payments.md). LMS's own Stripe account. Leave the key
# empty and Billing shows no Pay button, only the payment instructions. sk_test_ keys show a
# "Test mode" note on Billing. APP_URL above must be the public https address (Stripe sends
# clients back to it).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: STRIPE_PAYMENT_METHODS=card,acss_debit   STRIPE_CURRENCY=cad

# Invoicing add-on (docs/settled.md): where the portal reaches the Settled engine. Empty leaves
# Invoicing showing "being set up" even for clients who have it switched on.
SETTLED_URL=
